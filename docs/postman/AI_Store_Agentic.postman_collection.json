              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Agentic operation returns 400', function () { pm.response.to.have.status(400); });",
                  "const data = pm.response.json();",
                  "pm.expect(data.error_code).to.eql('agentic_operation_not_available');"
                ]
              }
            }
          ]
        },
